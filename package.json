{
  "name": "vscode-rmt",
  "displayName": "Remove Markup Tags",
  "description": "Efficiently strips HTML/XML markup tags from selected text, enhancing code readability and cleanup.",
  "version": "1.1.0",
  "publisher": "zero3",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zero3kw/vscode-rmt"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.removeMarkupTags",
        "title": "Remove Markup Tags"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "extension.removeMarkupTags",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Remove Markup Tags",
      "properties": {
        "removeMarkupTags.removeScriptAndStyleContent": {
          "type": "boolean",
          "default": true,
          "scope": "language-overridable",
          "description": "Remove <script> and <style> elements together with their contents, not just their tags."
        },
        "removeMarkupTags.decodeEntities": {
          "type": "boolean",
          "default": true,
          "scope": "language-overridable",
          "description": "Decode &lt; &gt; &amp; &quot; &apos; &nbsp; and numeric character references (&#8212; / &#x2014;) after removing tags."
        },
        "removeMarkupTags.replaceLineBreaks": {
          "type": "boolean",
          "default": true,
          "scope": "language-overridable",
          "description": "Replace <br> tags with a line break instead of removing them."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "jest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "~18.19.3",
    "@types/vscode": "1.85.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "packageManager": "pnpm@12.3.4"
}
