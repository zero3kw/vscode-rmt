# Whitelist: ignore every top-level entry, then re-include only what belongs in the repo.
# `/*` is root-anchored, so re-including a directory brings in its whole contents.
/*

# Directories
!/.devcontainer/
!/.github/
!/src/
!/images/
!/.vscode/
/.vscode/*
!/.vscode/launch.json
!/.vscode/tasks.json

# Root files
!/.gitattributes
!/.gitignore
!/.nvmrc
!/.vscodeignore
!/CHANGELOG.md
!/LICENSE.md
!/README.md
!/README.ja.md
!/eslint.config.mjs
!/icon.png
!/jest.config.js
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json

# Never track these, even inside re-included directories
.DS_Store
*.log
